{
  "manifest_version": 3,
  "name": "Wiki Trails",
  "short_name": "Wiki Trails",
  "version": "1.0.0",
  "key": "",
  "description": "Records the Wikipedia articles and Wiktionary entries you open, in any language, and the links you follow, and sends them to your own GitHub repository for Wiki Trails.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Wiki Trails",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "recorder.js",
    "scripts": [
      "recorder.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wikipedia.org/*",
        "https://*.wiktionary.org/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://erennere.github.io/wiki-trails/*"
      ],
      "js": [
        "appbridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "webNavigation"
  ],
  "homepage_url": "https://erennere.github.io/wiki-trails/"
}
